[Unit]
Description=Encrypted MyHostage database, content and configuration backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/srv/streamly/backup.env
ExecStart=/bin/sh /srv/streamly/app/scripts/backup-full.sh
Nice=10
IOSchedulingClass=idle
