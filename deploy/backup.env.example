# Install as /srv/streamly/backup.env with owner root and mode 0600.
# Initialize the encrypted repository separately after reviewing its destination.
RESTIC_REPOSITORY=/mnt/backup-nas/myhostage
RESTIC_PASSWORD_FILE=/root/.config/myhostage/restic-password
STREAMLY_RUNTIME_DIR=/srv/streamly/supabase
STREAMLY_STORAGE_DIR=/srv/streamly/supabase/volumes/storage
STREAMLY_ENV_FILE=/srv/streamly/app.env
STREAMLY_BACKUP_DIR=/srv/streamly/backups
# Optional private bundle: coturn config, custom units/scripts and host inventory.
# STREAMLY_INFRA_BACKUP_DIR=/srv/streamly/infrastructure-backup
