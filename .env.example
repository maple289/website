# Test deployment on the current Ubuntu VM. Replace with the public domain later.
APP_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

VITE_SUPABASE_URL=http://192.168.1.191
VITE_SUPABASE_ANON_KEY=replace-with-generated-anon-key
VITE_BASE_PATH=/
SUPABASE_API_UPSTREAM=host.docker.internal:8000

STREAMLY_IMAGE=streamly-web:local
STREAMLY_RUNTIME_DIR=/srv/streamly/supabase
STREAMLY_BACKUP_DIR=/srv/streamly/backups
STREAMLY_BACKUP_RETENTION_DAYS=30
STREAMLY_DEPLOY_LOCK=/srv/streamly/deploy.lock
STREAMLY_DEPLOY_STATE=/srv/streamly/last-deployed-sha
STREAMLY_HEALTH_URL=http://127.0.0.1/healthz
